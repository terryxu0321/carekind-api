# Copy to .env and fill in values. Never commit .env (code-rules CORE-03).
# JWT signing secret, at least 32 random characters.
JWT_SECRET=
# Password given to every seeded synthetic account by `npm run seed`, at least 14 characters.
SEED_PASSWORD=
# Optional: local PGlite data folder (default .data/pglite), API port (default 3000),
# admin web origin used in invite links (default http://localhost:5174).
DATABASE_DIR=
PORT=
ADMIN_WEB_URL=
