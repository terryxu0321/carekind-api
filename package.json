{
	"name": "carekind-api",
	"version": "0.1.0",
	"private": true,
	"description": "CareKind AI backend API (M0 admin: Super Admin + facility admin console)",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"start": "node dist/main.js",
		"seed": "npm run build && node dist/seed/run-seed.js",
		"db:generate": "node --conditions=import node_modules/drizzle-kit/bin.cjs generate"
	},
	"dependencies": {
		"@carekind/shared": "file:../../packages/carekind-shared",
		"@electric-sql/pglite": "^0.5.10",
		"@nestjs/common": "^12.2.0",
		"@nestjs/core": "^12.2.0",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/platform-express": "^12.2.0",
		"drizzle-orm": "^0.45.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@swc/core": "^1.16.18",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
